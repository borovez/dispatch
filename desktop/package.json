{
  "name": "dispatch-desktop",
  "productName": "Dispatch",
  "version": "0.9.1",
  "private": true,
  "description": "Dispatch as a Mac app: the local server and the web app in one window",
  "license": "MIT",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder --mac --publish never",
    "dist:all": "npm run bundle && electron-builder --mac --arm64 --x64 --publish never"
  },
  "build": {
    "appId": "app.dispatch.desktop",
    "productName": "Dispatch",
    "files": [
      "main.mjs",
      "preload.cjs",
      "lock.html",
      "app/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Dispatch ${version}"
    },
    "artifactName": "Dispatch-${version}-${arch}.${ext}",
    "asar": false,
    "electronVersion": "45.3.2"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "author": "Dispatch"
}
